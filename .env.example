# =============================================================================
# MailCheckr environment — copy to `.env` and replace every placeholder.
# This file contains NO real secrets. Never commit a filled-in .env.
# =============================================================================

# --- Runtime -------------------------------------------------------------------
# NODE_ENV: development | test | production
NODE_ENV=development
# LOG_LEVEL: fatal | error | warn | info | debug | trace (Pino structured logs)
LOG_LEVEL=info

# --- Web (Next.js) ----------------------------------------------------------------
# Public API base URL the BROWSER calls. Baked into the web bundle at build
# time (NEXT_PUBLIC_*), so rebuild the web image after changing it.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Host ports published by docker-compose (container ports stay fixed).
WEB_PORT=3000

# --- API (NestJS + Fastify) ----------------------------------------------------------
# API_PORT: port the API listens on. The web default above assumes 4000.
API_PORT=4000
# PORT: honoured as an alias by the API bootstrap when set (compose sets both).
PORT=4000
# WORKER_PORT: health/metrics port of the worker process (it serves no API).
WORKER_PORT=3002
# CORS_ORIGINS: comma-separated dashboard origins. No wildcards in production.
CORS_ORIGINS=http://localhost:3000
# JWT_SECRET: signing secret for dashboard session tokens. >= 32 random chars.
JWT_SECRET=change-me-at-least-32-chars-long-value
# JWT_EXPIRES_IN: dashboard access-token lifetime, e.g. 15m / 1h.
JWT_EXPIRES_IN=1h

# --- PostgreSQL -----------------------------------------------------------------------
POSTGRES_USER=mailcheckr
# POSTGRES_PASSWORD: database password (compose embeds it into DATABASE_URL).
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mailcheckr
POSTGRES_PORT=5432
# DATABASE_URL: Prisma connection string. docker-compose overrides the host
# with the in-network name `postgres`; this value is for non-Docker runs.
DATABASE_URL=postgresql://mailcheckr:mailcheckr@localhost:5432/mailcheckr

# --- Redis / BullMQ ---------------------------------------------------------------------
REDIS_PORT=6379
# REDIS_URL: queue transport, DNS/result cache, rate-limit store.
# docker-compose overrides the host with the in-network name `redis`.
REDIS_URL=redis://localhost:6379

# --- Encryption / hashing (application layer) ----------------------------------------------
# ENCRYPTION_KEY: 64 hex chars (32 bytes) — AES-256-GCM key encrypting stored
# email values at rest. Losing it makes stored addresses unrecoverable.
ENCRYPTION_KEY=change-me-64-hex-chars-for-aes-256-gcm-encryption-key-material
# HMAC_KEY: >= 32 chars — keyed HMAC digests for duplicate lookup (never an
# unsalted plain hash). Must differ from ENCRYPTION_KEY.
HMAC_KEY=change-me-at-least-32-chars-hmac-key
# API_KEY_PEPPER: pepper mixed into API-key hashes. Keys are shown once and
# never stored in plaintext.
API_KEY_PEPPER=change-me-api-key-pepper

# --- Deep SMTP release gate (PRD §6) ---------------------------------------------------------
# SMTP_DEEP_ENABLED and SMTP_EGRESS_APPROVED: BOTH must be true AND be backed
# by Phase-0 evidence on the REAL production worker (MX resolution works,
# TCP/25 connects to controlled MX hosts, provider approval in writing,
# PTR/rDNS verified — see docs/phase-0-audit.md). Leave both false otherwise;
# the product then honestly ships Quick mode only.
SMTP_DEEP_ENABLED=false
SMTP_EGRESS_APPROVED=false
# SMTP_PROBE_DOMAIN: controlled EHLO/MAIL FROM identity domain for probes.
SMTP_PROBE_DOMAIN=probe.example.invalid
# SMTP_TIMEOUT_MS: hard connect/read timeout for one SMTP probe.
SMTP_TIMEOUT_MS=10000
# SMTP_MAX_RETRIES: bounded retries for transient 4xx/greylist outcomes only.
SMTP_MAX_RETRIES=1
# WORKER_CONCURRENCY: global verification concurrency per worker process.
WORKER_CONCURRENCY=10
# DNS_CACHE_MAX_TTL_SECONDS: conservative cap applied to DNS TTL caching.
DNS_CACHE_MAX_TTL_SECONDS=300

# --- Resource protection (abuse / cost controls; see docs/api.md "Limits") -------------------------
# RATE_LIMIT_PER_MINUTE: per-tenant (per-user AND per-API-key) request budget.
RATE_LIMIT_PER_MINUTE=120
# RATE_LIMIT_VERIFY_PER_DAY: per-tenant daily verification ceiling (abuse brake).
RATE_LIMIT_VERIFY_PER_DAY=50000
# MAX_UPLOAD_BYTES: hard upload ceiling — 5 MiB. Enforced before parsing.
MAX_UPLOAD_BYTES=5242880
# MAX_CSV_ROWS: CSV batch ceiling — 10,000 rows (streaming parser; never whole-file in RAM).
MAX_CSV_ROWS=10000
# MAX_BATCH_CSV_ROWS: alias kept for the API's dashboard-CSV check; keep equal to MAX_CSV_ROWS.
MAX_BATCH_CSV_ROWS=10000
# MAX_BATCH_JSON_EMAILS: cap for POST /v1/batches with a JSON email array — 1,000.
MAX_BATCH_JSON_EMAILS=1000
# WORKER_MAX_ATTEMPTS: BullMQ job retry budget — 3 attempts total, exponential
# backoff with jitter, then the job fails terminally (no endless retries).
WORKER_MAX_ATTEMPTS=3
# PER_DOMAIN_CONCURRENCY: max simultaneous verifications per recipient domain
# (and, for Deep, per MX host) — protects remote servers and the probe IP.
PER_DOMAIN_CONCURRENCY=2
# FREE_CREDITS_GRANT: provisional free grant (PRD §9.2 — validate with costs).
FREE_CREDITS_GRANT=100

# --- Retention --------------------------------------------------------------------------------------
# SOURCE_RETENTION_DAYS: raw uploaded source lifetime after processing (1 = 24h per PRD §10.2).
SOURCE_RETENTION_DAYS=1
# RESULT_RETENTION_DAYS: verification-result lifetime before automatic expiry.
RESULT_RETENTION_DAYS=7

# --- Object storage (S3-compatible, uploads/exports) ---------------------------------------------------
# S3_ENDPOINT: leave empty for AWS S3; set for MinIO/other S3-compatible stores.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=mailcheckr-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Billing (provider-neutral; unused until Phase 9) ------------------------------------------------------
# BILLING_PROVIDER: empty = billing disabled. Core logic never hard-codes a vendor.
BILLING_PROVIDER=
RETENTION_DAYS=7
RATE_LIMIT_SINGLE_PER_MIN=60
RATE_LIMIT_BATCH_PER_HOUR=5
MAX_CONCURRENT_PER_DOMAIN=2
DOMAIN_COOLDOWN_MS=60000
