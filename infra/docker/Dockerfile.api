# MailCheckr API (NestJS + Fastify) — multi-stage build.
# Build context: repository root.  docker build -f infra/docker/Dockerfile.api .
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/datasets/package.json packages/datasets/package.json
RUN pnpm install --frozen-lockfile --filter @mailcheckr/api... || pnpm install --filter @mailcheckr/api...

FROM base AS build
COPY --from=deps /app /app
COPY . .
RUN pnpm --filter @mailcheckr/database exec prisma generate \
 && pnpm --filter @mailcheckr/contracts build \
 && pnpm --filter @mailcheckr/datasets build \
 && pnpm --filter @mailcheckr/core build \
 && pnpm --filter @mailcheckr/api build

FROM node:22-alpine AS runtime
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate \
 && addgroup -S mailcheckr && adduser -S mailcheckr -G mailcheckr
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app /app
# OpenAPI spec (Defect fix): the API serves the checked-in spec from disk —
# apps/api/src/openapi/openapi.controller.ts resolves, for the compiled
# layout dist/openapi/ -> ../../../../docs/openapi.json, i.e. exactly
# /app/docs/openapi.json in this image (also matched by the <cwd>/docs
# candidate). .dockerignore keeps docs/* out of the build context except
# this one file; copy it explicitly so its presence does not depend on the
# build stage's COPY . . behaviour. Verified in CI by running this image
# and curling GET /v1/openapi.json (see .github/workflows/ci.yml).
COPY docs/openapi.json ./docs/openapi.json
USER mailcheckr
EXPOSE 4000
# Migrations are an explicit deploy step (see docs/deployment.md):
#   docker compose run --rm api pnpm --filter @mailcheckr/database exec prisma migrate deploy
CMD ["node", "apps/api/dist/main.js"]
